{
  "$docs": "See docs/CC-CONFIG.md for field reference, docs/ENVIRONMENT_VARIABLES.md for env precedence, docs/MCP-SANDBOX-PATTERNS.md for external MCP server patterns (sandboxed execution + indexed search). Do NOT bundle third-party MCP servers in installers.",
  "ollamaUrl": "http://localhost:11434",
  "ollamaApiKey": "",
  "provider": "ollama",
  "openrouterApiKey": "",
  "openrouterUrl": "https://openrouter.ai/api/v1",
  "dictateGroqApiKey": "",
  "icmTemplatePath": "",
  "organizationName": "",
  "reviewTimeoutSec": 300,
  "chatTimeoutSec": 600,
  "numCtx": 0,
  "autoAdjustContext": true,
  "enablePreflightBanner": false,
  "cumulativeToolOutputMaxChars": 100000,
  "externalizeToolOutput": false,
  "enableHistoryCompaction": false,
  "historyCompactKeepRecent": 10,
  "historyCompactCloudAllowed": false,
  "historyCompactMaxSummaryChars": 2000,
  "historyCompactSummarizerModelLocal": "",
  "preferredPort": 8900,
  "selectedModel": "",
  "projectFolder": "",
  "mcpClients": [
    {
      "id": "archon",
      "name": "Archon",
      "transport": "http",
      "command": "",
      "args": [],
      "env": {},
      "url": "http://127.0.0.1:8051/mcp",
      "autoConnect": true,
      "disabledTools": []
    },
    {
      "id": "crawl4ai-rag",
      "name": "Crawl4AI RAG",
      "transport": "sse",
      "command": "",
      "args": [],
      "env": {},
      "url": "http://127.0.0.1:8054/sse",
      "autoConnect": false,
      "disabledTools": []
    }
  ],
  "memory": {
    "enabled": false,
    "embeddingModel": "",
    "maxContextTokens": 500,
    "recallThreshold": 0.6,
    "autoExtract": true,
    "maxMemories": 500,
    "hybridRecall": false,
    "recallTurns": 3,
    "indexCache": {
      "enabled": false
    },
    "pruneCheck": {
      "enabled": true,
      "intervalDays": 24,
      "sampleSize": 50,
      "thresholds": {
        "nearDuplicateSimilarity": 0.86,
        "lowSignalScoreThreshold": 0.6,
        "minContentLength": 24,
        "staleDays": 120
      }
    }
  },
  "imageSupport": {
    "enabled": true,
    "maxSizeMB": 25,
    "maxDimensionPx": 8192,
    "compressionQuality": 0.9,
    "maxImagesPerMessage": 10,
    "resizeThreshold": 2048,
    "warnOnFirstUpload": true
  },
  "docling": {
    "url": "http://127.0.0.1:5002",
    "apiKey": "",
    "enabled": true,
    "maxFileSizeMB": 50,
    "outputFormat": "md",
    "ocr": true,
    "ocrEngine": "easyocr",
    "timeoutSec": 120
  },
  "agentTerminal": {
    "enabled": false,
    "allowlist": [],
    "blocklist": ["sudo", "su", "rm -rf", "chmod 777", "mkfs", "dd"],
    "maxTimeoutSec": 60,
    "maxOutputKB": 256,
    "confirmBeforeRun": false
  },
  "agentValidate": {
    "enabled": true
  },
  "agentPlanner": {
    "enabled": true
  },
  "agentAppSkills": {
    "enabled": false,
    "review": false,
    "pentest": false,
    "builderScore": false
  },
  "experimentMode": {
    "enabled": true,
    "maxRounds": 8,
    "maxDurationSec": 900,
    "commandProfile": "safe",
    "confirmBeforeApply": false
  },
  "chatRequireExplicitFileWrites": false,
  "mcpServer": {
    "httpEnabled": true
  }
}
